# ──────────────────────────────────────────────────────
# RELIA 2.0 Agêntico — Variáveis de Ambiente
# Copie este ficheiro para .env e preencha as chaves.
# ──────────────────────────────────────────────────────

# Segurança (altere em produção!)
SECRET_KEY=relia-phd-super-secret-key-2026-humanidades-digitais

# Provedor de LLM padrão: gemini | openai | claude | ollama
DEFAULT_LLM_PROVIDER=gemini

# Chaves de API (preencha apenas o provedor escolhido)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (servidor local)
OLLAMA_BASE_URL=http://localhost:11434
